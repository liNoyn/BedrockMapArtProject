<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BMAG.App.ViewModels"
        xmlns:pal="using:BMAG.Palette"
        xmlns:world="using:BMAG.Bedrock.World"
        xmlns:core="using:BMAG.Palette"
        x:Class="BMAG.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Bedrock Map Art Generator"
        Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        DragDrop.AllowDrop="True">

  <DockPanel>
    <!-- Menu -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="ファイル(_F)">
        <MenuItem Header="新規プロジェクト" Command="{Binding NewProjectCommand}" />
        <MenuItem Header="プロジェクトを開く…" Command="{Binding OpenProjectCommand}" />
        <MenuItem Header="プロジェクトを保存" Command="{Binding SaveProjectCommand}" InputGesture="Ctrl+S" />
        <MenuItem Header="名前を付けて保存…" Command="{Binding SaveProjectAsCommand}" />
        <Separator />
        <MenuItem Header="画像を開く…" Command="{Binding OpenImageCommand}" InputGesture="Ctrl+O" />
      </MenuItem>
    </Menu>

    <!-- Bottom: log -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#40808080" BorderThickness="0,1,0,0" Height="150">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,4">
          <ProgressBar IsIndeterminate="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Width="160" />
          <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBox Text="{Binding LogText}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas, Yu Gothic UI"
                 FontSize="12" Margin="8,0,8,8" x:Name="LogBox" />
      </DockPanel>
    </Border>

    <!-- Left: image settings -->
    <Border DockPanel.Dock="Left" Width="300" BorderBrush="#40808080" BorderThickness="0,0,1,0">
      <ScrollViewer>
        <StackPanel Margin="12" Spacing="4">
          <TextBlock Classes="h" Text="プロジェクト" Margin="0,0,0,4" />
          <TextBox Text="{Binding ProjectName}" />

          <TextBlock Classes="h" Text="画像" />
          <Button Content="画像を開く…" Command="{Binding OpenImageCommand}" HorizontalAlignment="Stretch" />
          <TextBlock Classes="note" Text="{Binding SourceInfo}" />
          <TextBlock Classes="note" Text="ウィンドウに画像をドラッグ＆ドロップしても開けます。" />

          <TextBlock Classes="h" Text="地図の枚数" />
          <Grid ColumnDefinitions="*,Auto,*">
            <ComboBox ItemsSource="{Binding GridSizes}" SelectedItem="{Binding MapsX}" HorizontalAlignment="Stretch" />
            <TextBlock Grid.Column="1" Text=" × " VerticalAlignment="Center" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding GridSizes}" SelectedItem="{Binding MapsY}" HorizontalAlignment="Stretch" />
          </Grid>
          <TextBlock Classes="note" Text="{Binding OutputSizeText}" />

          <TextBlock Classes="h" Text="配置" />
          <ComboBox ItemsSource="{Binding FitModes}" SelectedItem="{Binding Fit}" HorizontalAlignment="Stretch" />
          <ComboBox ItemsSource="{Binding Interpolations}" SelectedItem="{Binding Interp}" HorizontalAlignment="Stretch" />
          <TextBlock Text="{Binding Zoom, StringFormat='拡大 {0:0.00}x'}" />
          <Slider Minimum="0.25" Maximum="4" Value="{Binding Zoom}" />
          <TextBlock Text="{Binding OffsetX, StringFormat='横位置 {0:0.00}'}" />
          <Slider Minimum="-1" Maximum="1" Value="{Binding OffsetX}" />
          <TextBlock Text="{Binding OffsetY, StringFormat='縦位置 {0:0.00}'}" />
          <Slider Minimum="-1" Maximum="1" Value="{Binding OffsetY}" />

          <TextBlock Classes="h" Text="色の補正" />
          <TextBlock Text="{Binding Brightness, StringFormat='明るさ {0:0.00}'}" />
          <Slider Minimum="-1" Maximum="1" Value="{Binding Brightness}" />
          <TextBlock Text="{Binding Contrast, StringFormat='コントラスト {0:0.00}'}" />
          <Slider Minimum="-1" Maximum="1" Value="{Binding Contrast}" />
          <TextBlock Text="{Binding Saturation, StringFormat='彩度 {0:0.00}'}" />
          <Slider Minimum="-1" Maximum="1" Value="{Binding Saturation}" />
          <TextBlock Text="{Binding Gamma, StringFormat='ガンマ {0:0.00}'}" />
          <Slider Minimum="0.3" Maximum="3" Value="{Binding Gamma}" />
          <TextBlock Text="{Binding Sharpen, StringFormat='シャープ {0:0.00}'}" />
          <Slider Minimum="0" Maximum="2" Value="{Binding Sharpen}" />

          <TextBlock Classes="h" Text="背景・透明" />
          <TextBox Text="{Binding BackgroundColor}" Watermark="#FFFFFF" />
          <CheckBox Content="透明を保持する（地図直接生成向け・未検証）" IsChecked="{Binding KeepTransparency}" />
          <TextBlock Classes="note" Text="オフのとき透明部分は背景色と合成します。" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Right: modes -->
    <Border DockPanel.Dock="Right" Width="470" BorderBrush="#40808080" BorderThickness="1,0,0,0">
      <TabControl Padding="0">

        <!-- Block construction -->
        <TabItem Header="ブロック建築">
          <ScrollViewer>
            <StackPanel Margin="12" Spacing="4">
              <TextBlock Classes="h" Text="色プロファイル" Margin="0" />
              <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="pal:ColorProfile">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="note" Text="{Binding ProfileNote}" />

              <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,6,0,0">
                <TextBlock Text="色差の計算" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Metrics}" SelectedItem="{Binding Metric}" HorizontalAlignment="Stretch" Margin="0,2" />
                <TextBlock Grid.Row="1" Text="ディザリング" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Dithers}" SelectedItem="{Binding Dither}" HorizontalAlignment="Stretch" Margin="0,2" />
                <TextBlock Grid.Row="2" Text="建築方式" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding BuildModes}" SelectedItem="{Binding BuildModeOption}" HorizontalAlignment="Stretch" Margin="0,2" />
                <TextBlock Grid.Row="3" Text="希少度" VerticalAlignment="Center" />
                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Rarities}" SelectedItem="{Binding MaxRarity}" HorizontalAlignment="Stretch" Margin="0,2" />
                <TextBlock Grid.Row="4" Text="種類の上限" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding MaxBlockTypes}" Minimum="0" Maximum="200" FormatString="0" Margin="0,2" />
                <TextBlock Grid.Row="5" Text="支えブロック" VerticalAlignment="Center" />
                <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding SupportBlocks}" SelectedItem="{Binding SelectedSupportBlock}" HorizontalAlignment="Stretch" Margin="0,2">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="pal:BlockDefinition">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <TextBlock Classes="warn" IsVisible="{Binding IsStaircase}"
                         Text="Staircase は Java 版の陰影規則を仮定した実験機能です。Bedrock の陰影は「地図・校正」タブで実測してから使ってください。" />
              <CheckBox Content="重力ブロック（砂など）を使わない" IsChecked="{Binding ExcludeGravity}" />
              <CheckBox Content="燃えるブロックを使わない" IsChecked="{Binding ExcludeFlammable}" />
              <TextBlock Classes="note" Text="0 = 種類の上限なし。使えるブロックの選択は「パレット」タブで行います。" />

              <TextBlock Classes="h" Text="建築位置（ワールド座標）" />
              <CheckBox Content="地図の範囲に合わせた座標を出力する" IsChecked="{Binding UseOrigin}" />
              <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" IsEnabled="{Binding UseOrigin}">
                <TextBlock Text="地図X" VerticalAlignment="Center" Margin="0,0,4,0" />
                <NumericUpDown Grid.Column="1" Value="{Binding OriginMapX}" FormatString="0" Minimum="-100000" Maximum="100000" />
                <TextBlock Grid.Column="2" Text="地図Z" VerticalAlignment="Center" Margin="6,0,4,0" />
                <NumericUpDown Grid.Column="3" Value="{Binding OriginMapZ}" FormatString="0" Minimum="-100000" Maximum="100000" />
                <TextBlock Grid.Column="4" Text="Y" VerticalAlignment="Center" Margin="6,0,4,0" />
                <NumericUpDown Grid.Column="5" Value="{Binding OriginY}" FormatString="0" Minimum="-64" Maximum="319" />
              </Grid>
              <TextBlock Classes="note" Text="{Binding OriginText}" />

              <TextBlock Classes="h" Text="結果" />
              <TextBlock Text="{Binding BlockSummary}" TextWrapping="Wrap" />
              <Button Content="建築データを出力（ガイド・構造物・ビヘイビアパック）…" Command="{Binding ExportBlockCommand}"
                      Classes="accent" HorizontalAlignment="Stretch" Margin="0,6" />

              <TextBlock Classes="h" Text="必要素材" />
              <ItemsControl ItemsSource="{Binding Materials}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MaterialViewModel">
                    <Grid ColumnDefinitions="18,*,Auto" Margin="0,2">
                      <Border Width="14" Height="14" Background="{Binding Swatch}" BorderBrush="Gray" BorderThickness="1" VerticalAlignment="Top" Margin="0,2,0,0" />
                      <StackPanel Grid.Column="1" Margin="4,0">
                        <TextBlock>
                          <Run Text="{Binding Name}" />
                          <Run Text="{Binding Kind, StringFormat=' ({0})'}" Foreground="Gray" FontSize="11" />
                        </TextBlock>
                        <TextBlock Classes="note" Text="{Binding Maps, StringFormat='マップ {0}'}" />
                        <TextBlock Classes="note" Text="{Binding Alternatives}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Count, StringFormat='{}{0:N0} 個'}" HorizontalAlignment="Right" />
                        <TextBlock Classes="note" Text="{Binding Stacks}" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Direct map -->
        <TabItem Header="地図直接生成">
          <ScrollViewer>
            <StackPanel Margin="12" Spacing="6">
              <TextBlock Classes="note" Text="画像をそのまま地図データ（RGBA）としてワールドのコピーへ追加します。元のワールドは変更しません。Minecraft は終了しておいてください。" />
              <TextBlock Classes="h" Text="ワールド" />
              <ComboBox ItemsSource="{Binding Worlds}" SelectedItem="{Binding SelectedWorld}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="world:WorldInfo">
                    <TextBlock Text="{Binding Display}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="再検出" Command="{Binding RefreshWorldsCommand}" />
                <Button Content="フォルダを選択…" Command="{Binding BrowseWorldCommand}" />
              </StackPanel>
              <TextBlock Classes="note" Text="{Binding WorldDetails}" />

              <TextBlock Classes="h" Text="設定" />
              <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto">
                <TextBlock Text="開始 ID" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding StartId}" Margin="0,2" />
                <TextBlock Grid.Row="1" Text="受け取り方法" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Deliveries}" SelectedItem="{Binding Delivery}" HorizontalAlignment="Stretch" Margin="0,2" />
              </Grid>
              <CheckBox Content="輝く額縁を使う" IsChecked="{Binding GlowFrames}" />
              <CheckBox Content="額縁の後ろに壁を付ける" IsChecked="{Binding BackingWall}" />
              <TextBlock Classes="note" Text="使用中の ID は自動的に避けます。地図・チェスト・額縁は構造物としてコピー内に保存され、/structure load で取り出せます。" />

              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                <Button Content="書き込み内容を確認" Command="{Binding PlanWorldExportCommand}" />
                <Button Content="コピーを作成して地図を追加…" Command="{Binding ExecuteWorldExportCommand}" Classes="accent" />
              </StackPanel>
              <Button Content="地図画像を PNG で出力…" Command="{Binding ExportTilesCommand}" HorizontalAlignment="Left" />
              <SelectableTextBlock Text="{Binding PlanText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Maps & calibration -->
        <TabItem Header="地図・校正">
          <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Top" Spacing="6">
              <TextBlock Classes="note" Text="「地図直接生成」タブで選んだワールドの地図を読み取り専用で表示します。" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="地図を読み込む" Command="{Binding LoadMapsCommand}" />
                <Button Content="PNG で保存…" Command="{Binding ExportMapPngCommand}" />
                <Button Content="元画像として使う" Command="{Binding UseMapAsSourceCommand}" />
              </StackPanel>
            </StackPanel>
            <Expander DockPanel.Dock="Bottom" Header="色の校正（実機測定）" Margin="0,8,0,0">
              <StackPanel Spacing="6">
                <TextBlock Classes="note" Text="全ブロックを並べたテストパッドをゲーム内に置いて地図を作り、その地図から実際の地図色を測定します。" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                  <TextBlock Text="地図X" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <NumericUpDown Grid.Column="1" Value="{Binding CalibrationMapX}" FormatString="0" Minimum="-100000" Maximum="100000" />
                  <TextBlock Grid.Column="2" Text="地図Z" VerticalAlignment="Center" Margin="6,0,4,0" />
                  <NumericUpDown Grid.Column="3" Value="{Binding CalibrationMapZ}" FormatString="0" Minimum="-100000" Maximum="100000" />
                  <TextBlock Grid.Column="4" Text="Y" VerticalAlignment="Center" Margin="6,0,4,0" />
                  <NumericUpDown Grid.Column="5" Value="{Binding CalibrationY}" FormatString="0" Minimum="-64" Maximum="319" />
                </Grid>
                <TextBlock Classes="note" Text="{Binding CalibrationText}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="テストパッドを出力…" Command="{Binding ExportCalibrationPackCommand}" />
                  <Button Content="選択した地図で測定" Command="{Binding MeasureCalibrationCommand}" />
                  <Button Content="実測プロファイルとして保存" Command="{Binding SaveCalibratedProfileCommand}" Classes="accent" />
                </StackPanel>
                <ScrollViewer MaxHeight="220">
                  <SelectableTextBlock Text="{Binding CalibrationResult}" TextWrapping="Wrap" FontSize="12" />
                </ScrollViewer>
              </StackPanel>
            </Expander>
            <ListBox ItemsSource="{Binding WorldMaps}" SelectedItem="{Binding SelectedMap}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MapEntryViewModel">
                  <Grid ColumnDefinitions="72,*">
                    <Border Width="64" Height="64" Background="#20808080">
                      <Image Source="{Binding Thumbnail}" RenderOptions.BitmapInterpolationMode="None" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="6,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                      <TextBlock Classes="note" Text="{Binding Info}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>

        <!-- Palette -->
        <TabItem Header="パレット">
          <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Top" Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="すべて使う" Command="{Binding PaletteAllCommand}" />
                <Button Content="すべて外す" Command="{Binding PaletteNoneCommand}" />
                <Button Content="初期設定" Command="{Binding PaletteDefaultCommand}" />
              </StackPanel>
              <TextBlock Classes="note" Text="{Binding PaletteSummary}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding PaletteItems}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PaletteItemViewModel">
                  <Grid ColumnDefinitions="Auto,22,*">
                    <CheckBox IsChecked="{Binding IsEnabled}" MinWidth="0" />
                    <Border Grid.Column="1" Width="16" Height="16" Background="{Binding Swatch}" BorderBrush="Gray" BorderThickness="1" />
                    <StackPanel Grid.Column="2" Margin="6,0">
                      <TextBlock>
                        <Run Text="{Binding Name}" />
                        <Run Text="{Binding Category, StringFormat=' · {0}'}" Foreground="Gray" FontSize="11" />
                      </TextBlock>
                      <TextBlock Classes="note">
                        <Run Text="{Binding ColorText}" />
                        <Run Text="{Binding Status, StringFormat=' · {0}'}" />
                      </TextBlock>
                      <TextBlock Classes="note" Text="{Binding Identifier}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Border>

    <!-- Center: preview -->
    <DockPanel ClipToBounds="True">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*" Margin="10,8">
        <ComboBox ItemsSource="{Binding PreviewModes}" SelectedItem="{Binding SelectedPreviewMode}" Width="230" />
        <CheckBox Grid.Column="1" Content="地図・構造物の境界を表示" IsChecked="{Binding ShowGrid}" Margin="10,0" />
        <TextBlock Grid.Column="2" Text="{Binding PreviewInfo}" ToolTip.Tip="{Binding PreviewInfo}" VerticalAlignment="Center"
                   FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
      </Grid>
      <Border Background="#18808080" Margin="10,0,10,10">
        <Grid>
          <Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" Margin="8" />
          <TextBlock Text="画像を開くか、ここにドロップしてください" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0.5" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNull}}" />
        </Grid>
      </Border>
    </DockPanel>
  </DockPanel>
</Window>
