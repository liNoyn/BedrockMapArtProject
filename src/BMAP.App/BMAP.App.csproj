<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BMAP.App</RootNamespace>
    <AssemblyName>BMAP</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.5.0</Version>
    <ApplicationIcon>Assets\bmap.ico</ApplicationIcon>
    <Product>Bedrock Map Art Project</Product>
    <Copyright>Copyright (c) 2026 Noyn (MIT)</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BMAP.Core\BMAP.Core.csproj" />
    <!-- Built first so its "textures" command can fetch the block textures below. -->
    <ProjectReference Include="..\BMAP.Cli\BMAP.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Block icons: Minecraft textures are fetched once from Mojang's bedrock-samples repository into
    .textures/ (git-ignored, never committed: (c) Mojang AB, Minecraft EULA) and copied next to BMAP.exe.
    Offline builds still succeed; the app then offers the download button instead.
    Disable with: dotnet build -p:BundleTextures=false
  -->
  <PropertyGroup>
    <BundleTextures Condition="'$(BundleTextures)' == ''">true</BundleTextures>
    <TextureCacheDir>$(MSBuildThisFileDirectory)..\..\.textures\vanilla</TextureCacheDir>
    <BmapCliDll>$(MSBuildThisFileDirectory)..\BMAP.Cli\bin\$(Configuration)\net8.0\BMAP.Cli.dll</BmapCliDll>
  </PropertyGroup>

  <Target Name="FetchBlockTextures" AfterTargets="Build" Condition="'$(BundleTextures)' == 'true'">
    <Exec Condition="!Exists('$(TextureCacheDir)\.complete')" Command="dotnet &quot;$(BmapCliDll)&quot; textures &quot;$(TextureCacheDir)&quot;"
          ContinueOnError="true" />
    <ItemGroup>
      <_BmapTexture Include="$(TextureCacheDir)\**\*" Exclude="$(TextureCacheDir)\.complete" />
    </ItemGroup>
    <Copy SourceFiles="@(_BmapTexture)" DestinationFiles="@(_BmapTexture->'$(OutDir)textures\vanilla\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" Condition="Exists('$(TextureCacheDir)\.complete')" />
  </Target>

  <Target Name="PublishBlockTextures" AfterTargets="Publish" Condition="'$(BundleTextures)' == 'true' And Exists('$(TextureCacheDir)\.complete')">
    <ItemGroup>
      <_BmapTexturePub Include="$(TextureCacheDir)\**\*" Exclude="$(TextureCacheDir)\.complete" />
    </ItemGroup>
    <Copy SourceFiles="@(_BmapTexturePub)" DestinationFiles="@(_BmapTexturePub->'$(PublishDir)textures\vanilla\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
