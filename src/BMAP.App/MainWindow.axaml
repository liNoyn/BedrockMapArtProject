<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BMAP.App.ViewModels"
        xmlns:pal="using:BMAP.Palette"
        xmlns:pb="using:BMAP.BlockEngine"
        xmlns:world="using:BMAP.Bedrock.World"
        x:Class="BMAP.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Bedrock Map Art Project"
        Icon="/Assets/bmap.ico"
        Width="1600" Height="980" MinWidth="1150" MinHeight="680"
        DragDrop.AllowDrop="True">

  <!-- MapartCraft layout: block selection | map preview + materials | settings + green buttons. -->
  <DockPanel>

    <!-- Header -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="12,6,12,2">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="h1" Text="Bedrock Map Art Project" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ProjectName}" Opacity="0.55" VerticalAlignment="Bottom" Margin="0,0,0,3" MaxWidth="320"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <WrapPanel Grid.Column="2" VerticalAlignment="Center">
        <Button Classes="link" Content="{Binding L[OpenImage]}" Command="{Binding OpenImageCommand}" />
        <Button Classes="link" Content="{Binding L[NewProject]}" Command="{Binding NewProjectCommand}" />
        <Button Classes="link" Content="{Binding L[OpenProject]}" Command="{Binding OpenProjectCommand}" />
        <Button Classes="link" Content="{Binding L[SaveProject]}" Command="{Binding SaveProjectCommand}" />
        <Button Classes="link" Content="{Binding L[SaveProjectAs]}" Command="{Binding SaveProjectAsCommand}" />
        <TextBlock Text="|" Opacity="0.4" VerticalAlignment="Center" Margin="2,0" />
        <Button Classes="link" Content="日本語" Command="{Binding SetJapaneseCommand}" />
        <Button Classes="link" Content="English" Command="{Binding SetEnglishCommand}" />
        <TextBlock Text="|" Opacity="0.4" VerticalAlignment="Center" Margin="2,0" />
        <Button Classes="link" Content="{Binding L[About]}" Command="{Binding AboutCommand}" />
      </WrapPanel>
    </Grid>

    <!-- Status bar + log -->
    <Border DockPanel.Dock="Bottom" Background="#2A2A2A" BorderBrush="#7BAE7F" BorderThickness="0,1,0,0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="10,3">
          <ProgressBar IsIndeterminate="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Width="120" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,12,0" />
          <TextBlock Grid.Column="2" Text="{Binding LastLog}" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="3" Classes="link" Content="{Binding L[OpenLogs]}" Command="{Binding OpenLogsCommand}" />
          <ToggleButton Grid.Column="4" x:Name="LogToggle" Content="{Binding L[Log]}" Padding="8,1" Margin="6,0,0,0" />
        </Grid>
        <TextBox x:Name="LogBox" Text="{Binding LogText}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas, Yu Gothic UI"
                 FontSize="12" Height="130" Margin="10,0,10,6" IsVisible="{Binding #LogToggle.IsChecked}" />
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="*,4,600,4,330">

      <!-- ===================== Block selection ===================== -->
      <DockPanel Margin="10,4,6,6">
        <StackPanel DockPanel.Dock="Top" Spacing="3">
          <TextBlock Classes="h2" Text="{Binding L[SecBlocks]}" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="lbl" Text="{Binding L[Preset]}" />
            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" MinWidth="190">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="pb:BlockPreset">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="small" Content="{Binding L[Load]}" Command="{Binding ApplyPresetCommand}" />
            <Button Classes="small" Content="{Binding L[DeletePreset]}" Command="{Binding DeletePresetCommand}" />
            <Button Classes="small" Content="{Binding L[Save]}" Command="{Binding SavePresetCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="small" Content="{Binding L[SelectAll]}" Command="{Binding SelectAllBlocksCommand}" />
            <Button Classes="small" Content="{Binding L[ClearAll]}" Command="{Binding ClearAllBlocksCommand}" />
            <ComboBox ItemsSource="{Binding Mixings}" SelectedItem="{Binding MixingOption}" MinWidth="200" ToolTip.Tip="{Binding L[MixingHint]}" />
            <TextBlock Text="{Binding PaletteSummary}" FontWeight="Bold" Foreground="#A6D8AA" VerticalAlignment="Center" Margin="6,0,0,0" />
          </StackPanel>
          <Button Content="{Binding L[DownloadTextures]}" Command="{Binding DownloadTexturesCommand}" Classes="green"
                  IsVisible="{Binding TexturesMissing}" HorizontalAlignment="Left" />
        </StackPanel>

        <Expander DockPanel.Dock="Bottom" Header="{Binding L[CustomBlocks]}">
          <StackPanel Spacing="4">
            <TextBox Text="{Binding CustomId}" Watermark="{Binding L[CustomId]}" />
            <TextBox Text="{Binding CustomStates}" Watermark="{Binding L[CustomStates]}" />
            <Grid ColumnDefinitions="*,6,*">
              <ComboBox ItemsSource="{Binding ColourSetsForCustom}" SelectedItem="{Binding CustomSet}" HorizontalAlignment="Stretch"
                        PlaceholderText="{Binding L[CustomSet]}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="pal:ColourSet">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox Grid.Column="2" Text="{Binding CustomColor}" Watermark="{Binding L[CustomColor]}" />
            </Grid>
            <WrapPanel>
              <CheckBox Content="{Binding L[CustomSupport]}" IsChecked="{Binding CustomSupport}" Margin="0,0,8,0" />
              <Button Classes="small" Content="{Binding L[AddCustom]}" Command="{Binding AddCustomCommand}" Margin="0,0,4,4" />
              <Button Classes="small" Content="{Binding L[ImportBp]}" Command="{Binding ImportBpFolderCommand}" Margin="0,0,4,4" />
              <Button Classes="small" Content="{Binding L[ImportBpFile]}" Command="{Binding ImportBpFileCommand}" Margin="0,0,4,4" />
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding CustomBlocks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CustomBlockViewModel">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" FontSize="12" />
                    <Button Grid.Column="1" Classes="small" Content="✕" Command="{Binding RemoveCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="small" Content="{Binding L[UseResourcePack]}" Command="{Binding UseResourcePackCommand}" HorizontalAlignment="Left" />
            <TextBlock Classes="note" Text="{Binding TextureStatus}" />
          </StackPanel>
        </Expander>

        <!-- Colour rows: shade swatch, "none", then the blocks of that colour (MapartCraft) -->
        <ScrollViewer Margin="0,4,0,0">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ColourSetRowViewModel">
                <Grid ColumnDefinitions="24,Auto,*">
                  <StackPanel VerticalAlignment="Top" Margin="0,3,3,0" ToolTip.Tip="{Binding Name}">
                    <Border Width="20" Height="21" BorderBrush="#40000000" BorderThickness="1" ClipToBounds="True">
                      <StackPanel>
                        <Border Height="7" Background="{Binding BrightBrush}" />
                        <Border Height="7" Background="{Binding NormalBrush}" />
                        <Border Height="7" Background="{Binding DarkBrush}" />
                      </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding CountBadge}" Foreground="#A6D8AA" FontSize="9" HorizontalAlignment="Center" />
                  </StackPanel>
                  <ToggleButton Grid.Column="1" Classes="blk" IsChecked="{Binding IsNone}" VerticalAlignment="Top" ToolTip.Tip="{Binding Loc[NoneBlock]}">
                    <Panel Width="24" Height="24">
                      <Ellipse Width="18" Height="18" Stroke="#E03030" StrokeThickness="2.5" />
                      <Line StartPoint="6,18" EndPoint="18,6" Stroke="#E03030" StrokeThickness="2.5" />
                    </Panel>
                  </ToggleButton>
                  <ItemsControl Grid.Column="2" ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:BlockChoiceViewModel">
                        <ToggleButton Classes="blk" IsChecked="{Binding IsSelected}" ToolTip.Tip="{Binding Tooltip}">
                          <Panel Width="24" Height="24">
                            <Border Background="{Binding Swatch}" IsVisible="{Binding !HasIcon}" />
                            <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" RenderOptions.BitmapInterpolationMode="None" />
                          </Panel>
                        </ToggleButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <GridSplitter Grid.Column="1" Background="#2A2A2A" ResizeDirection="Columns" />

      <!-- ===================== Map preview + materials ===================== -->
      <ScrollViewer x:Name="PreviewColumn" Grid.Column="2">
        <StackPanel Margin="8,4,8,8" Spacing="3">
          <TextBlock Classes="h2" Text="{Binding L[SecPreview]}" />
          <!-- Square preview as wide as the column (drag the splitters to resize); click it to choose an image
               (MapartCraft "PICK IMAGE"), double-click to enlarge. -->
          <Border x:Name="PreviewBox" Width="580" Height="580" Background="#7BAE7F" HorizontalAlignment="Left">
            <Grid>
              <Image x:Name="PreviewImage" Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"
                     Cursor="Cross" />
              <Canvas x:Name="CropOverlay" IsHitTestVisible="False">
                <Rectangle x:Name="CropRect" Stroke="#FF4040" StrokeThickness="2" StrokeDashArray="4,3" IsVisible="False" />
              </Canvas>
              <Button Command="{Binding OpenImageCommand}" IsVisible="{Binding !HasPreview}" Background="Transparent" BorderThickness="0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <StackPanel Spacing="8">
                  <Path Data="M 0,60 L 60,0 L 120,60 L 85,60 L 85,120 L 35,120 L 35,60 Z" Fill="#333333" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding L[PickImage]}" FontSize="30" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="{Binding OutputSizeText}" FontSize="12" VerticalAlignment="Center" />
            <Button Grid.Column="2" x:Name="ZoomButton" Classes="small" Content="{Binding L[ZoomPreview]}" ToolTip.Tip="{Binding L[ZoomPreviewTip]}"
                    IsEnabled="{Binding HasPreview}" Margin="6,0,0,0" VerticalAlignment="Center" />
            <ListBox Grid.Column="1" Classes="tabs" ItemsSource="{Binding PreviewModes}" SelectedItem="{Binding SelectedPreviewMode}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>
          </Grid>
          <TextBlock Classes="note" Text="{Binding PreviewInfo}" />
          <TextBlock Classes="note" Text="{Binding SourceInfo}" />
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasFrames}">
            <TextBlock Classes="lbl" Text="{Binding L[Frame]}" />
            <NumericUpDown Value="{Binding Frame}" Minimum="0" Maximum="{Binding MaxFrame}" FormatString="0" Width="110" />
            <TextBlock Text="{Binding FrameCount, StringFormat=' / {0}'}" VerticalAlignment="Center" />
            <Button Classes="small" Content="{Binding L[ReloadFrame]}" Command="{Binding ReloadFrameCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsVideo}">
            <TextBlock Classes="lbl" Text="{Binding L[VideoTime]}" />
            <NumericUpDown Value="{Binding VideoSeconds}" Minimum="0" Increment="0.5" FormatString="0.##" Width="110" />
            <Button Classes="small" Content="{Binding L[ReloadFrame]}" Command="{Binding ReloadFrameCommand}" />
          </StackPanel>

          <!-- Materials (MapartCraft shows them under the preview) -->
          <TextBlock Classes="h2" Text="{Binding L[SecMaterials]}" Margin="0,10,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="lbl" Text="{Binding L[MaterialsPerMap]}" />
            <ComboBox ItemsSource="{Binding MaterialAreas}" SelectedItem="{Binding MaterialArea}" MinWidth="130">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ViewAreaOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="small" Content="CSV" Command="{Binding ExportMaterialsCommand}" ToolTip.Tip="{Binding L[ExportMaterials]}" />
          </StackPanel>
          <Border BorderBrush="#808080" BorderThickness="0,0,0,1" Margin="0,4,0,1">
            <Grid ColumnDefinitions="28,*,90,66,70">
              <TextBlock Grid.Column="1" Text="{Binding L[Block]}" FontWeight="Bold" />
              <TextBlock Grid.Column="2" Text="{Binding L[Amount]}" FontWeight="Bold" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="3" Text="{Binding L[Owned]}" FontWeight="Bold" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="{Binding L[Missing]}" FontWeight="Bold" HorizontalAlignment="Right" />
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding Materials}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MaterialViewModel">
                <Grid ColumnDefinitions="28,*,90,66,70" Margin="0,1">
                  <Panel Width="22" Height="22" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Border Background="{Binding Swatch}" IsVisible="{Binding !HasIcon}" />
                    <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" RenderOptions.BitmapInterpolationMode="None" />
                  </Panel>
                  <StackPanel Grid.Column="1" Margin="2,0">
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Classes="note" Text="{Binding Maps}" FontSize="10" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Count, StringFormat='{}{0:N0}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12" />
                    <TextBlock Classes="note" Text="{Binding Stacks}" HorizontalAlignment="Right" FontSize="10" />
                  </StackPanel>
                  <NumericUpDown Grid.Column="3" Value="{Binding Owned}" Minimum="0" Maximum="10000000" FormatString="0"
                                 ShowButtonSpinner="False" Margin="4,0" VerticalAlignment="Top" />
                  <TextBlock Grid.Column="4" Text="{Binding MissingText}" HorizontalAlignment="Right" FontSize="12" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Expander Header="{Binding L[Progress]}" Margin="0,6,0,0">
            <ItemsControl ItemsSource="{Binding MapProgress}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MapProgressViewModel">
                  <Grid ColumnDefinitions="40,150,*" Margin="0,1">
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="Bold" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding State}" HorizontalAlignment="Stretch" />
                    <TextBlock Grid.Column="2" Text="{Binding ChunksText}" VerticalAlignment="Center" Margin="6,0" Classes="note" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </StackPanel>
      </ScrollViewer>

      <GridSplitter Grid.Column="3" Background="#2A2A2A" ResizeDirection="Columns" />

      <!-- ===================== Settings ===================== -->
      <ScrollViewer Grid.Column="4">
        <StackPanel Margin="6,4,12,10" Spacing="1" Grid.IsSharedSizeScope="True">
          <TextBlock Classes="h2" Text="{Binding L[SecSettings]}" />

          <Grid Classes="row">
            <Grid.ColumnDefinitions><ColumnDefinition SharedSizeGroup="L" Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Classes="lbl" Text="{Binding L[OutputFormat]}" />
            <TextBlock Grid.Column="1" Text="{Binding L[OutputFormatValue]}" VerticalAlignment="Center" FontSize="12" />
          </Grid>
          <Grid Classes="row">
            <Grid.ColumnDefinitions><ColumnDefinition SharedSizeGroup="L" Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Classes="lbl" Text="{Binding L[ProfileVersion]}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedBaseProfile}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="{Binding ProfileNote}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="pal:ColorProfile">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <Grid Classes="row">
            <Grid.ColumnDefinitions><ColumnDefinition SharedSizeGroup="L" Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Classes="lbl" Text="{Binding L[MapSize]}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ComboBox ItemsSource="{Binding GridSizes}" SelectedItem="{Binding MapsX}" Width="64" />
              <TextBlock Text=" × " VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding GridSizes}" SelectedItem="{Binding MapsY}" Width="64" />
            </StackPanel>
          </Grid>
          <Grid Classes="row">
            <Grid.ColumnDefinitions><ColumnDefinition SharedSizeGroup="L" Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Classes="lbl" Text="{Binding L[Crop]}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding CropModes}" SelectedItem="{Binding CropModeOption}" HorizontalAlignment="Stretch" />
          </Grid>
          <Border Classes="group" IsVisible="{Binding IsManualCrop}">
            <StackPanel Spacing="2">
              <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*">
                <TextBlock Classes="lbl" Text="X" />
                <NumericUpDown Grid.Column="1" Value="{Binding CropX}" FormatString="0" Minimum="0" Maximum="100000" ShowButtonSpinner="False" />
                <TextBlock Grid.Column="2" Classes="lbl" Text="Y" Margin="4,0" />
                <NumericUpDown Grid.Column="3" Value="{Binding CropY}" FormatString="0" Minimum="0" Maximum="100000" ShowButtonSpinner="False" />
                <TextBlock Grid.Column="4" Classes="lbl" Text="W" Margin="4,0" />
                <NumericUpDown Grid.Column="5" Value="{Binding CropW}" FormatString="0" Minimum="1" Maximum="100000" ShowButtonSpinner="False" />
                <TextBlock Grid.Column="6" Classes="lbl" Text="H" Margin="4,0" />
                <NumericUpDown Grid.Column="7" Value="{Binding CropH}" FormatString="0" Minimum="1" Maximum="100000" ShowButtonSpinner="False" />
              </Grid>
              <TextBlock Classes="note" Text="{Binding L[CropDragHint]}" />
            </StackPanel>
          </Border>
          <Grid Classes="row">
            <Grid.ColumnDefinitions><ColumnDefinition SharedSizeGroup="L" Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Classes="lbl" Text="{Binding L[ShowGridShort]}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding ShowGrid}" />
          </Grid>
          <Grid Classes="row">
            <Grid.ColumnDefinitions><ColumnDefinition SharedSizeGroup="L" Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Classes="lbl" Text="{Binding L[Staircase]}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Staircases}" SelectedItem="{Binding StaircaseOption}" HorizontalAlignment="Stretch" />
          </Grid>
          <Border Classes="group" IsVisible="{Binding IsStaircase}">
            <StackPanel Spacing="2">
              <Grid ColumnDefinitions="Auto,*" IsEnabled="{Binding CanLimitHeight}">
                <TextBlock Classes="lbl" Text="{Binding L[MaxHeight]}" />
                <NumericUpDown Grid.Column="1" Value="{Binding MaxHeight}" Minimum="0" Maximum="383" FormatString="0" ToolTip.Tip="{Binding L[MaxHeightHint]}" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Classes="lbl" Text="{Binding L[ShadePenalty]}" ToolTip.Tip="{Binding L[ShadePenaltyHint]}" />
                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ShadePenalty}" ToolTip.Tip="{Binding L[ShadePenaltyHint]}" />
              </Grid>
              <TextBlock Classes="note" Text="{Binding L[ShadeRuleShort]}" ToolTip.Tip="{Binding L[ShadeRuleNote]}" />
            </StackPanel>
          </Border>
          <Grid Classes="row">
            <Grid.ColumnDefinitions><ColumnDefinition SharedSizeGroup="L" Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Classes="lbl" Text="{Binding L[SupportMode]}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding SupportModes}" SelectedItem="{Binding SupportModeOption}" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid Classes="row">
            <Grid.ColumnDefinitions><ColumnDefinition SharedSizeGroup="L" Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Classes="lbl" Text="{Binding L[SupportBlock]}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding SupportBlocks}" SelectedItem="{Binding SelectedSupportBlock}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="pal:BlockDefinition">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <Grid Classes="row">
            <Grid.ColumnDefinitions><ColumnDefinition SharedSizeGroup="L" Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Classes="lbl" Text="{Binding L[Metric]}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Metrics}" SelectedItem="{Binding Metric}" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid Classes="row">
            <Grid.ColumnDefinitions><ColumnDefinition SharedSizeGroup="L" Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Classes="lbl" Text="{Binding L[Dither]}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Dithers}" SelectedItem="{Binding Dither}" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid Classes="row">
            <Grid.ColumnDefinitions><ColumnDefinition SharedSizeGroup="L" Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Classes="lbl" Text="{Binding L[Background]}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding TransparencyModes}" SelectedItem="{Binding Transparency}" HorizontalAlignment="Stretch" />
          </Grid>

          <Expander Header="{Binding L[Preprocessing]}">
            <StackPanel Spacing="1">
              <Grid ColumnDefinitions="96,*,44"><TextBlock Classes="lbl" Text="{Binding L[Brightness]}" /><Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding Brightness}" /><TextBlock Grid.Column="2" Classes="val" Text="{Binding Brightness, StringFormat='{}{0:0.00}'}" /></Grid>
              <Grid ColumnDefinitions="96,*,44"><TextBlock Classes="lbl" Text="{Binding L[Contrast]}" /><Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding Contrast}" /><TextBlock Grid.Column="2" Classes="val" Text="{Binding Contrast, StringFormat='{}{0:0.00}'}" /></Grid>
              <Grid ColumnDefinitions="96,*,44"><TextBlock Classes="lbl" Text="{Binding L[Saturation]}" /><Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding Saturation}" /><TextBlock Grid.Column="2" Classes="val" Text="{Binding Saturation, StringFormat='{}{0:0.00}'}" /></Grid>
              <Grid ColumnDefinitions="96,*,44"><TextBlock Classes="lbl" Text="{Binding L[Gamma]}" /><Slider Grid.Column="1" Minimum="0.3" Maximum="3" Value="{Binding Gamma}" /><TextBlock Grid.Column="2" Classes="val" Text="{Binding Gamma, StringFormat='{}{0:0.00}'}" /></Grid>
              <Grid ColumnDefinitions="96,*,44"><TextBlock Classes="lbl" Text="{Binding L[Sharpen]}" /><Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding Sharpen}" /><TextBlock Grid.Column="2" Classes="val" Text="{Binding Sharpen, StringFormat='{}{0:0.00}'}" /></Grid>
              <Grid ColumnDefinitions="96,*,44"><TextBlock Classes="lbl" Text="{Binding L[Zoom]}" /><Slider Grid.Column="1" Minimum="0.25" Maximum="4" Value="{Binding Zoom}" /><TextBlock Grid.Column="2" Classes="val" Text="{Binding Zoom, StringFormat='{}{0:0.00}x'}" /></Grid>
              <Grid ColumnDefinitions="96,*,44"><TextBlock Classes="lbl" Text="{Binding L[OffsetX]}" /><Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding OffsetX}" /><TextBlock Grid.Column="2" Classes="val" Text="{Binding OffsetX, StringFormat='{}{0:0.00}'}" /></Grid>
              <Grid ColumnDefinitions="96,*,44"><TextBlock Classes="lbl" Text="{Binding L[OffsetY]}" /><Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding OffsetY}" /><TextBlock Grid.Column="2" Classes="val" Text="{Binding OffsetY, StringFormat='{}{0:0.00}'}" /></Grid>
              <Grid ColumnDefinitions="96,*"><TextBlock Classes="lbl" Text="{Binding L[Placement]}" /><ComboBox Grid.Column="1" ItemsSource="{Binding FitModes}" SelectedItem="{Binding Fit}" HorizontalAlignment="Stretch" /></Grid>
              <Grid ColumnDefinitions="96,*" Margin="0,2,0,0"><TextBlock Classes="lbl" Text="{Binding L[Resample]}" /><ComboBox Grid.Column="1" ItemsSource="{Binding Interpolations}" SelectedItem="{Binding Interp}" HorizontalAlignment="Stretch" /></Grid>
              <Grid ColumnDefinitions="96,*" Margin="0,2,0,0"><TextBlock Classes="lbl" Text="#" /><TextBox Grid.Column="1" Text="{Binding BackgroundColor}" Watermark="#FFFFFF" ToolTip.Tip="{Binding L[BackgroundColourTip]}" /></Grid>
              <Button Classes="small" Content="{Binding L[FlatBackground]}" Command="{Binding FlatBackgroundCommand}" ToolTip.Tip="{Binding L[FlatBackgroundHint]}" HorizontalAlignment="Left" Margin="0,2" />
              <CheckBox Content="{Binding L[LinearLight]}" IsChecked="{Binding LinearLight}" />
              <TextBlock Classes="h" Text="{Binding L[Dither]}" />
              <Grid ColumnDefinitions="96,*,44"><TextBlock Classes="lbl" Text="{Binding L[DitherStrength]}" /><Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding DitherStrength}" /><TextBlock Grid.Column="2" Classes="val" Text="{Binding DitherStrength, StringFormat='{}{0:P0}'}" /></Grid>
              <CheckBox Content="{Binding L[Serpentine]}" IsChecked="{Binding Serpentine}" />
              <CheckBox Content="{Binding L[LinearDiffusion]}" IsChecked="{Binding LinearDiffusion}" />
            </StackPanel>
          </Expander>

          <Expander Header="{Binding L[Extras]}">
            <StackPanel Spacing="2">
              <Grid ColumnDefinitions="Auto,*"><TextBlock Classes="lbl" Text="{Binding L[Project]}" /><TextBox Grid.Column="1" Text="{Binding ProjectName}" /></Grid>
              <Grid ColumnDefinitions="Auto,*"><TextBlock Classes="lbl" Text="{Binding L[MaxTypes]}" ToolTip.Tip="{Binding L[MaxTypesHint]}" /><NumericUpDown Grid.Column="1" Value="{Binding MaxBlockTypes}" Minimum="0" Maximum="400" FormatString="0" /></Grid>
              <Grid ColumnDefinitions="Auto,*"><TextBlock Classes="lbl" Text="{Binding L[Output]}" /><ComboBox Grid.Column="1" ItemsSource="{Binding Splits}" SelectedItem="{Binding SplitOption}" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding L[SplitHint]}" /></Grid>
              <CheckBox Content="{Binding L[WriteBP]}" IsChecked="{Binding WriteBehaviorPack}" />
              <CheckBox Content="{Binding L[UseOrigin]}" IsChecked="{Binding UseOrigin}" ToolTip.Tip="{Binding L[UseOriginHint]}" />
              <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" IsEnabled="{Binding UseOrigin}">
                <TextBlock Classes="lbl" Text="{Binding L[MapX]}" />
                <NumericUpDown Grid.Column="1" Value="{Binding OriginMapX}" FormatString="0" Minimum="-100000" Maximum="100000" ShowButtonSpinner="False" />
                <TextBlock Grid.Column="2" Classes="lbl" Text="{Binding L[MapZ]}" Margin="4,0" />
                <NumericUpDown Grid.Column="3" Value="{Binding OriginMapZ}" FormatString="0" Minimum="-100000" Maximum="100000" ShowButtonSpinner="False" />
                <TextBlock Grid.Column="4" Classes="lbl" Text="Y" Margin="4,0" />
                <NumericUpDown Grid.Column="5" Value="{Binding OriginY}" FormatString="0" Minimum="-64" Maximum="319" ShowButtonSpinner="False" />
              </Grid>
              <TextBlock Classes="note" Text="{Binding OriginText}" />
              <SelectableTextBlock Text="{Binding PlacementText}" TextWrapping="Wrap" FontSize="11" Opacity="0.8" />
              <Button Classes="small" Content="{Binding L[ApplyRecommendedY]}" Command="{Binding ApplyRecommendedYCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Expander>

          <!-- Green buttons (MapartCraft: View online / Download) -->
          <StackPanel Margin="0,6,0,0">
            <Button Classes="green" Content="{Binding L[BtnView3D]}" Command="{Binding View3DCommand}" />
            <Button Classes="green large" Content="{Binding L[BtnExport]}" Command="{Binding ExportBlockCommand}" />
            <Button Classes="green" Content="{Binding L[BtnSavePng]}" Command="{Binding SavePreviewPngCommand}" />
          </StackPanel>

          <!-- Check result, always visible in one line; details folded -->
          <TextBlock Text="{Binding ShadingVerdict}" Classes="ok" IsVisible="{Binding ShadingOk}" FontSize="12" Margin="0,4,0,0" />
          <TextBlock Text="{Binding ShadingVerdict}" Classes="bad" IsVisible="{Binding ShadingProblem}" FontSize="12" Margin="0,4,0,0" />
          <Expander Header="{Binding L[SecAnalysis]}">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding ShadingText}" TextWrapping="Wrap" FontSize="12" />
              <TextBlock Text="{Binding BlockSummary}" TextWrapping="Wrap" FontSize="12" />
              <TextBlock Classes="note" Text="{Binding ProfileNote}" />
              <Button Classes="small" Content="{Binding L[PvShadeMap]}" Command="{Binding ShowShadeMapCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Expander>
          <Expander Header="{Binding L[SecHeight]}" IsVisible="{Binding IsStaircase}">
            <StackPanel Spacing="3">
              <TextBlock Classes="note" Text="{Binding L[HeightAnalysisHint]}" />
              <Button Classes="green" Content="{Binding L[AnalyzeHeight]}" Command="{Binding AnalyzeHeightCommand}" />
              <ProgressBar Value="{Binding AnalysisProgress}" Maximum="100" IsVisible="{Binding IsAnalyzing}" />
              <TextBlock Text="{Binding HeightAnalysisNote}" TextWrapping="Wrap" FontWeight="Bold" FontSize="12" />
              <ItemsControl ItemsSource="{Binding HeightRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HeightRowViewModel">
                    <Grid ColumnDefinitions="48,64,*,38,Auto" Margin="0,1">
                      <TextBlock Text="{Binding LimitText}" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" ToolTip.Tip="{Binding Badge}" />
                      <TextBlock Grid.Column="1" Text="{Binding HeightText}" VerticalAlignment="Center" FontSize="11" />
                      <ProgressBar Grid.Column="2" Value="{Binding Quality}" Maximum="100" MinWidth="30" Height="8" VerticalAlignment="Center" Margin="4,0" />
                      <TextBlock Grid.Column="3" Text="{Binding QualityText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"
                                 Foreground="{Binding IsRecommended, Converter={x:Static vm:Converters.RecommendedBrush}}" />
                      <Button Grid.Column="4" Classes="small" Content="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[UseThis]}"
                              Command="{Binding ApplyCommand}" Margin="4,0,0,0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>
          <Expander Header="{Binding L[SecCalibration]}" IsExpanded="{Binding CalExpanded}">
            <StackPanel Spacing="3">
              <TextBlock Classes="note" Text="{Binding L[CalIntro]}" />
              <Button Classes="green" Content="{Binding L[BtnTestPad]}" Command="{Binding ExportTestPadCommand}" />
              <Grid ColumnDefinitions="*,Auto,Auto">
                <Button Classes="green" Content="{Binding L[CalColourPad]}" Command="{Binding ExportColourPadCommand}" />
                <TextBlock Grid.Column="1" Text="{Binding L[CalStep]}" VerticalAlignment="Center" Margin="6,0,4,0" FontSize="12" />
                <NumericUpDown Grid.Column="2" Value="{Binding ColourPadStep}" Minimum="1" Maximum="8" FormatString="0" Width="90" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Classes="lbl" Text="{Binding L[CalWorld]}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding CalWorlds}" SelectedItem="{Binding CalWorld}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="world:WorldInfo">
                      <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <WrapPanel>
                <Button Classes="small" Content="{Binding L[CalRefresh]}" Command="{Binding RefreshCalWorldsCommand}" Margin="0,0,4,4" />
                <Button Classes="small" Content="{Binding L[CalBrowse]}" Command="{Binding BrowseCalWorldCommand}" Margin="0,0,4,4" />
                <Button Classes="small" Content="{Binding L[CalLoadPad]}" Command="{Binding LoadPadCommand}" Margin="0,0,4,4" />
              </WrapPanel>
              <TextBlock Classes="note" Text="{Binding PadText}" />
              <Button Classes="green" Content="{Binding L[CalRead]}" Command="{Binding ReadMapsCommand}" />
              <SelectableTextBlock Text="{Binding CalibrationReport}" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas, Yu Gothic UI" />
              <Button Classes="small" Content="{Binding L[CalSave]}" Command="{Binding SaveCalibrationCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
