<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BMAP.App.ViewModels"
        xmlns:pal="using:BMAP.Palette"
        xmlns:pb="using:BMAP.BlockEngine"
        x:Class="BMAP.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Bedrock Map Art Project"
        Icon="/Assets/bmap.ico"
        Width="1640" Height="980" MinWidth="1180" MinHeight="700"
        DragDrop.AllowDrop="True">

  <!-- Layout after MapartCraft: block selection | map preview | map settings + buttons + materials. -->
  <DockPanel>

    <!-- Header: title on the left, project / language / help links on the right -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="14,8,14,2">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="h1" Text="Bedrock Map Art Project" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ProjectName}" Opacity="0.6" VerticalAlignment="Bottom" Margin="0,0,0,4" MaxWidth="360"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <WrapPanel Grid.Column="2" VerticalAlignment="Center">
        <Button Classes="link" Content="{Binding L[OpenImage]}" Command="{Binding OpenImageCommand}" />
        <Button Classes="link" Content="{Binding L[NewProject]}" Command="{Binding NewProjectCommand}" />
        <Button Classes="link" Content="{Binding L[OpenProject]}" Command="{Binding OpenProjectCommand}" />
        <Button Classes="link" Content="{Binding L[SaveProject]}" Command="{Binding SaveProjectCommand}" />
        <Button Classes="link" Content="{Binding L[SaveProjectAs]}" Command="{Binding SaveProjectAsCommand}" />
        <TextBlock Text="|" Opacity="0.4" VerticalAlignment="Center" Margin="4,0" />
        <Button Classes="link" Content="日本語" Command="{Binding SetJapaneseCommand}" />
        <Button Classes="link" Content="English" Command="{Binding SetEnglishCommand}" />
        <TextBlock Text="|" Opacity="0.4" VerticalAlignment="Center" Margin="4,0" />
        <Button Classes="link" Content="{Binding L[About]}" Command="{Binding AboutCommand}" />
      </WrapPanel>
    </Grid>

    <!-- Status bar + collapsible log (MapartCraft shows messages in a corner box) -->
    <Border DockPanel.Dock="Bottom" Background="#2A2A2A" BorderBrush="#7BAE7F" BorderThickness="0,1,0,0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="10,4">
          <ProgressBar IsIndeterminate="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Width="140" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,12,0" />
          <TextBlock Grid.Column="2" Text="{Binding LastLog}" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="3" Classes="link" Content="{Binding L[OpenLogs]}" Command="{Binding OpenLogsCommand}" />
          <ToggleButton Grid.Column="4" x:Name="LogToggle" Content="{Binding L[Log]}" Padding="10,2" Margin="6,0,0,0" />
        </Grid>
        <TextBox x:Name="LogBox" Text="{Binding LogText}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas, Yu Gothic UI"
                 FontSize="12" Height="140" Margin="10,0,10,8" IsVisible="{Binding #LogToggle.IsChecked}" />
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="430,4,*,4,420">

      <!-- ===================== Block selection ===================== -->
      <Border Classes="section">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4">
            <TextBlock Classes="h2" Text="{Binding L[SecBlocks]}" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
              <TextBlock Classes="lbl" Text="{Binding L[Preset]}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="pb:BlockPreset">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="2" Content="{Binding L[Load]}" Command="{Binding ApplyPresetCommand}" Margin="4,0,0,0" />
              <Button Grid.Column="3" Content="{Binding L[Save]}" Command="{Binding SavePresetCommand}" Margin="4,0,0,0" />
              <Button Grid.Column="4" Content="{Binding L[DeletePreset]}" Command="{Binding DeletePresetCommand}" Margin="4,0,0,0" />
            </Grid>
            <Grid ColumnDefinitions="Auto,Auto,*">
              <Button Content="{Binding L[SelectAll]}" Command="{Binding SelectAllBlocksCommand}" Margin="0,0,4,0" />
              <Button Grid.Column="1" Content="{Binding L[ClearAll]}" Command="{Binding ClearAllBlocksCommand}" Margin="0,0,8,0" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding Mixings}" SelectedItem="{Binding MixingOption}" HorizontalAlignment="Stretch"
                        ToolTip.Tip="{Binding L[MixingHint]}" />
            </Grid>
            <TextBlock Text="{Binding PaletteSummary}" FontWeight="Bold" Foreground="#A6D8AA" />
            <WrapPanel IsVisible="{Binding TexturesMissing}">
              <Button Content="{Binding L[DownloadTextures]}" Command="{Binding DownloadTexturesCommand}" Classes="green" Margin="0,0,4,2" />
            </WrapPanel>
          </StackPanel>

          <Expander DockPanel.Dock="Bottom" Header="{Binding L[CustomBlocks]}">
            <StackPanel Spacing="6">
              <TextBox Text="{Binding CustomId}" Watermark="{Binding L[CustomId]}" />
              <TextBox Text="{Binding CustomStates}" Watermark="{Binding L[CustomStates]}" />
              <Grid ColumnDefinitions="*,8,*">
                <ComboBox ItemsSource="{Binding ColourSetsForCustom}" SelectedItem="{Binding CustomSet}" HorizontalAlignment="Stretch"
                          PlaceholderText="{Binding L[CustomSet]}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="pal:ColourSet">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Grid.Column="2" Text="{Binding CustomColor}" Watermark="{Binding L[CustomColor]}" />
              </Grid>
              <WrapPanel>
                <CheckBox Content="{Binding L[CustomSupport]}" IsChecked="{Binding CustomSupport}" Margin="0,0,8,0" />
                <Button Content="{Binding L[AddCustom]}" Command="{Binding AddCustomCommand}" Margin="0,0,4,4" />
                <Button Content="{Binding L[ImportBp]}" Command="{Binding ImportBpFolderCommand}" Margin="0,0,4,4" />
                <Button Content="{Binding L[ImportBpFile]}" Command="{Binding ImportBpFileCommand}" Margin="0,0,4,4" />
              </WrapPanel>
              <ItemsControl ItemsSource="{Binding CustomBlocks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CustomBlockViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                      <TextBlock Text="{Binding Text}" VerticalAlignment="Center" FontSize="12" />
                      <Button Grid.Column="1" Content="✕" Command="{Binding RemoveCommand}" Padding="6,0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="{Binding L[UseResourcePack]}" Command="{Binding UseResourcePackCommand}" />
              <TextBlock Classes="note" Text="{Binding TextureStatus}" />
            </StackPanel>
          </Expander>

          <!-- Colour rows: colour box, "none", then the blocks of that colour -->
          <ScrollViewer Margin="0,6,0,0">
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ColourSetRowViewModel">
                  <Grid ColumnDefinitions="30,Auto,*" Margin="0,0,0,1">
                    <StackPanel VerticalAlignment="Top" Margin="0,5,4,0" ToolTip.Tip="{Binding Name}">
                      <Border Width="24" Height="24" BorderBrush="#33000000" BorderThickness="1" ClipToBounds="True">
                        <StackPanel>
                          <Border Height="8" Background="{Binding BrightBrush}" />
                          <Border Height="8" Background="{Binding NormalBrush}" />
                          <Border Height="8" Background="{Binding DarkBrush}" />
                        </StackPanel>
                      </Border>
                      <TextBlock Text="{Binding CountBadge}" Foreground="#A6D8AA" FontSize="10" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Classes="blk" IsChecked="{Binding IsNone}" VerticalAlignment="Top"
                                  ToolTip.Tip="{Binding Loc[NoneBlock]}">
                      <Panel Width="32" Height="32">
                        <Ellipse Width="22" Height="22" Stroke="#E03030" StrokeThickness="3" />
                        <Line StartPoint="9,23" EndPoint="23,9" Stroke="#E03030" StrokeThickness="3" />
                      </Panel>
                    </ToggleButton>
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Blocks}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BlockChoiceViewModel">
                          <ToggleButton Classes="blk" IsChecked="{Binding IsSelected}" ToolTip.Tip="{Binding Tooltip}">
                            <Panel Width="32" Height="32">
                              <Border Background="{Binding Swatch}" IsVisible="{Binding !HasIcon}" />
                              <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" RenderOptions.BitmapInterpolationMode="None" />
                            </Panel>
                          </ToggleButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Background="#2A2A2A" ResizeDirection="Columns" />

      <!-- ===================== Map preview ===================== -->
      <Border Grid.Column="2" Classes="section">
        <DockPanel ClipToBounds="True">
          <TextBlock DockPanel.Dock="Top" Classes="h2" Text="{Binding L[SecPreview]}" />
          <ListBox DockPanel.Dock="Top" Classes="tabs" ItemsSource="{Binding PreviewModes}" SelectedItem="{Binding SelectedPreviewMode}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>

          <!-- Tools of the current view -->
          <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,0">
            <WrapPanel IsVisible="{Binding IsBuildView}">
              <ComboBox ItemsSource="{Binding ViewAreas}" SelectedItem="{Binding ViewArea}" MinWidth="110" Margin="0,0,8,4">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ViewAreaOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding L[CellSize]}" VerticalAlignment="Center" Margin="0,0,4,0" IsVisible="{Binding IsBuildScroll}" />
              <Slider Minimum="1" Maximum="24" Value="{Binding CellSize}" Width="110" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,8,0"
                      IsVisible="{Binding IsBuildScroll}" />
              <CheckBox Content="{Binding L[ShowHeights]}" IsChecked="{Binding ShowHeights}" IsVisible="{Binding IsBuildScroll}" Margin="0,0,8,0" />
              <CheckBox Content="{Binding L[EditProgress]}" IsChecked="{Binding EditProgress}" IsVisible="{Binding IsBuildScroll}" Margin="0,0,8,0" />
              <CheckBox Content="{Binding L[Paint]}" IsChecked="{Binding PaintMode}" IsVisible="{Binding IsBuildScroll}" Margin="0,0,8,0" />
            </WrapPanel>
            <!-- 3D controls -->
            <WrapPanel IsVisible="{Binding IsBuild3D}">
              <ComboBox ItemsSource="{Binding ColorModes3D}" SelectedItem="{Binding ColorMode3D}" Width="190" Margin="0,0,6,4" />
              <Button Content="{Binding L[Reset3D]}" Command="{Binding Reset3DCommand}" Margin="0,0,4,4" />
              <Button Content="{Binding L[TopView3D]}" Command="{Binding TopView3DCommand}" Margin="0,0,4,4" />
              <Button Content="{Binding L[Turn3D]}" Command="{Binding Turn3DCommand}" Margin="0,0,4,4" />
              <Button Content="{Binding L[Tallest3D]}" Command="{Binding Tallest3DCommand}" Margin="0,0,8,4" />
              <CheckBox Content="{Binding L[Lighting3D]}" IsChecked="{Binding Lighting3D}" Margin="0,0,8,0" />
              <CheckBox Content="{Binding L[Grid3D]}" IsChecked="{Binding Grid3D}" Margin="0,0,8,0" />
              <CheckBox Content="{Binding L[Outlines3D]}" IsChecked="{Binding Outlines3D}" Margin="0,0,8,0" />
              <CheckBox Content="{Binding L[Perspective3D]}" IsChecked="{Binding Perspective3D}" Margin="0,0,8,0" />
              <CheckBox Content="{Binding L[ShowSupports]}" IsChecked="{Binding ShowSupports}" Margin="0,0,8,0" />
              <StackPanel Orientation="Horizontal" Margin="0,0,8,4">
                <TextBlock Text="{Binding L[Layer3D]}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider Minimum="0" Maximum="{Binding MaxLayer3D}" Value="{Binding Layer3D}" Width="150" IsSnapToTickEnabled="True" TickFrequency="1" />
                <TextBlock Text="{Binding Layer3DText}" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="90" />
              </StackPanel>
            </WrapPanel>
            <!-- Paint tools -->
            <WrapPanel IsVisible="{Binding PaintMode}">
              <TextBlock Text="{Binding L[Brush]}" VerticalAlignment="Center" Margin="0,0,4,0" />
              <ComboBox ItemsSource="{Binding Brushes}" SelectedItem="{Binding Brush}" Width="220" Margin="0,0,6,4">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:BrushOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox ItemsSource="{Binding BrushShades}" SelectedItem="{Binding BrushShade}" Width="90" Margin="0,0,6,4" IsVisible="{Binding IsStaircase}" />
              <Button Content="{Binding L[Undo]}" Command="{Binding UndoEditCommand}" Margin="0,0,6,4" ToolTip.Tip="Ctrl+Z" />
              <Button Content="{Binding L[ClearEdits]}" Command="{Binding ClearEditsCommand}" Margin="0,0,6,4" />
              <TextBlock Text="{Binding EditsText}" VerticalAlignment="Center" Classes="note" />
            </WrapPanel>
          </WrapPanel>

          <!-- Source image line (MapartCraft: map size and image under the preview) -->
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
            <StackPanel>
              <TextBlock Text="{Binding OutputSizeText}" FontWeight="Bold" />
              <TextBlock Classes="note" Text="{Binding SourceInfo}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasFrames}">
                <TextBlock Text="{Binding L[Frame]}" VerticalAlignment="Center" FontSize="12" />
                <NumericUpDown Value="{Binding Frame}" Minimum="0" Maximum="{Binding MaxFrame}" FormatString="0" Width="110" />
                <TextBlock Text="{Binding FrameCount, StringFormat=' / {0}'}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsVideo}">
                <TextBlock Text="{Binding L[VideoTime]}" VerticalAlignment="Center" FontSize="12" />
                <NumericUpDown Value="{Binding VideoSeconds}" Minimum="0" Increment="0.5" FormatString="0.##" Width="110" />
              </StackPanel>
              <Button Content="{Binding L[ReloadFrame]}" Command="{Binding ReloadFrameCommand}" IsVisible="{Binding HasFrames}" />
              <Button Content="{Binding L[ReloadFrame]}" Command="{Binding ReloadFrameCommand}" IsVisible="{Binding IsVideo}" />
              <Button Classes="green" Content="{Binding L[OpenImage]}" Command="{Binding OpenImageCommand}" Padding="16,0" />
            </StackPanel>
          </Grid>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding HoverInfo}" FontSize="12" Margin="2,2" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding IsBuildScroll}" />
          <StackPanel DockPanel.Dock="Bottom" Margin="2,2" IsVisible="{Binding IsBuild3D}">
            <TextBlock Text="{Binding View3DInfo}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding L[Help3D]}" FontSize="11" Opacity="0.6" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding PreviewInfo}" FontSize="12" Opacity="0.75" Margin="2,2" TextWrapping="Wrap" />

          <Border Background="#262626" BorderBrush="#555555" BorderThickness="1">
            <Grid>
              <Image x:Name="PreviewImage" Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" Margin="6"
                     IsVisible="{Binding IsImageView}" Cursor="Cross" />
              <Canvas x:Name="CropOverlay" IsHitTestVisible="False">
                <Rectangle x:Name="CropRect" Stroke="#FF4040" StrokeThickness="2" StrokeDashArray="4,3" IsVisible="False" />
              </Canvas>
              <Border x:Name="View3DPanel" IsVisible="{Binding IsBuild3D}" Background="#22262E" ClipToBounds="True" Cursor="SizeAll">
                <Image Source="{Binding View3D}" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" />
              </Border>
              <ScrollViewer IsVisible="{Binding IsBuildScroll}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="BuildImage" Source="{Binding Preview}" Stretch="None" RenderOptions.BitmapInterpolationMode="None"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" />
              </ScrollViewer>
              <!-- Empty preview: click to open an image (MapartCraft opens the file dialog from the preview) -->
              <Button Command="{Binding OpenImageCommand}" IsVisible="{Binding !HasPreview}" Background="Transparent" BorderThickness="0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <StackPanel Spacing="6">
                  <TextBlock Text="🖼" FontSize="48" HorizontalAlignment="Center" Opacity="0.6" />
                  <TextBlock Text="{Binding L[ClickToOpen]}" HorizontalAlignment="Center" Opacity="0.7" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="3" Background="#2A2A2A" ResizeDirection="Columns" />

      <!-- ===================== Map settings, buttons, materials ===================== -->
      <ScrollViewer Grid.Column="4">
        <StackPanel Margin="8,6,12,12" Spacing="2">
          <TextBlock Classes="h2" Text="{Binding L[SecSettings]}" />

          <StackPanel Classes="setting">
            <TextBlock Classes="lbl" Text="{Binding L[OutputFormat]}" />
            <TextBlock Text="{Binding L[OutputFormatValue]}" VerticalAlignment="Center" />
          </StackPanel>

          <Grid ColumnDefinitions="Auto,*" Margin="0,3">
            <TextBlock Classes="lbl" Text="{Binding L[ProfileVersion]}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedBaseProfile}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="pal:ColorProfile">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <TextBlock Classes="note" Text="{Binding ProfileNote}" />

          <StackPanel Classes="setting">
            <TextBlock Classes="lbl" Text="{Binding L[MapSize]}" />
            <ComboBox ItemsSource="{Binding GridSizes}" SelectedItem="{Binding MapsX}" Width="70" />
            <TextBlock Text=" × " VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding GridSizes}" SelectedItem="{Binding MapsY}" Width="70" />
          </StackPanel>

          <Grid ColumnDefinitions="Auto,*" Margin="0,3">
            <TextBlock Classes="lbl" Text="{Binding L[Crop]}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding CropModes}" SelectedItem="{Binding CropModeOption}" HorizontalAlignment="Stretch" />
          </Grid>
          <Border Classes="group" IsVisible="{Binding IsManualCrop}">
            <StackPanel Spacing="3">
              <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*">
                <TextBlock Classes="lbl" Text="X" />
                <NumericUpDown Grid.Column="1" Value="{Binding CropX}" FormatString="0" Minimum="0" Maximum="100000" ShowButtonSpinner="False" />
                <TextBlock Grid.Column="2" Classes="lbl" Text="Y" Margin="6,0,6,0" />
                <NumericUpDown Grid.Column="3" Value="{Binding CropY}" FormatString="0" Minimum="0" Maximum="100000" ShowButtonSpinner="False" />
                <TextBlock Grid.Column="4" Classes="lbl" Text="W" Margin="6,0,6,0" />
                <NumericUpDown Grid.Column="5" Value="{Binding CropW}" FormatString="0" Minimum="1" Maximum="100000" ShowButtonSpinner="False" />
                <TextBlock Grid.Column="6" Classes="lbl" Text="H" Margin="6,0,6,0" />
                <NumericUpDown Grid.Column="7" Value="{Binding CropH}" FormatString="0" Minimum="1" Maximum="100000" ShowButtonSpinner="False" />
              </Grid>
              <TextBlock Classes="note" Text="{Binding L[CropDragHint]}" />
            </StackPanel>
          </Border>

          <CheckBox Content="{Binding L[ShowGrid]}" IsChecked="{Binding ShowGrid}" FontWeight="Bold" />

          <!-- 3D (staircasing) -->
          <Grid ColumnDefinitions="Auto,*" Margin="0,3">
            <TextBlock Classes="lbl" Text="{Binding L[Staircase]}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Staircases}" SelectedItem="{Binding StaircaseOption}" HorizontalAlignment="Stretch" />
          </Grid>
          <Border Classes="group" IsVisible="{Binding IsStaircase}">
            <StackPanel Spacing="4">
              <TextBlock Classes="note" Text="{Binding L[ShadeRuleNote]}" />
              <Grid ColumnDefinitions="Auto,*" IsEnabled="{Binding CanLimitHeight}">
                <TextBlock Classes="lbl" Text="{Binding L[MaxHeight]}" />
                <NumericUpDown Grid.Column="1" Value="{Binding MaxHeight}" Minimum="0" Maximum="383" FormatString="0" />
              </Grid>
              <TextBlock Classes="note" Text="{Binding L[MaxHeightHint]}" />
              <TextBlock><Run Text="{Binding L[ShadePenalty]}" FontWeight="Bold" /><Run Text="{Binding ShadePenalty, StringFormat='{} {0:P0}'}" /></TextBlock>
              <Slider Minimum="0" Maximum="1" Value="{Binding ShadePenalty}" />
              <TextBlock Classes="note" Text="{Binding L[ShadePenaltyHint]}" />
              <Button Content="{Binding L[FlatBackground]}" Command="{Binding FlatBackgroundCommand}" HorizontalAlignment="Stretch" />
              <TextBlock Classes="note" Text="{Binding L[FlatBackgroundHint]}" />
              <Button Content="{Binding L[AnalyzeHeight]}" Command="{Binding AnalyzeHeightCommand}" Classes="green" />
              <ProgressBar Value="{Binding AnalysisProgress}" Maximum="100" IsVisible="{Binding IsAnalyzing}" />
              <TextBlock Classes="note" Text="{Binding L[HeightAnalysisHint]}" />
              <TextBlock Text="{Binding HeightAnalysisNote}" TextWrapping="Wrap" FontWeight="Bold" />
              <ItemsControl ItemsSource="{Binding HeightRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HeightRowViewModel">
                    <Grid ColumnDefinitions="56,70,*,40,Auto" Margin="0,1">
                      <TextBlock Text="{Binding LimitText}" VerticalAlignment="Center" FontWeight="Bold" ToolTip.Tip="{Binding Badge}" />
                      <TextBlock Grid.Column="1" Text="{Binding HeightText}" VerticalAlignment="Center" FontSize="12" />
                      <ProgressBar Grid.Column="2" Value="{Binding Quality}" Maximum="100" MinWidth="30" Height="10" VerticalAlignment="Center" Margin="4,0" />
                      <TextBlock Grid.Column="3" Text="{Binding QualityText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"
                                 Foreground="{Binding IsRecommended, Converter={x:Static vm:Converters.RecommendedBrush}}" />
                      <Button Grid.Column="4" Content="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[UseThis]}"
                              Command="{Binding ApplyCommand}" Padding="6,1" Margin="4,0,0,0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="warn" Text="{Binding L[StairWarn]}" />
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="Auto,*" Margin="0,3">
            <TextBlock Classes="lbl" Text="{Binding L[SupportMode]}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding SupportModes}" SelectedItem="{Binding SupportModeOption}" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" Margin="0,3">
            <TextBlock Classes="lbl" Text="{Binding L[SupportBlock]}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding SupportBlocks}" SelectedItem="{Binding SelectedSupportBlock}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="pal:BlockDefinition">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <Grid ColumnDefinitions="Auto,*" Margin="0,3">
            <TextBlock Classes="lbl" Text="{Binding L[Background]}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding TransparencyModes}" SelectedItem="{Binding Transparency}" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" Margin="0,3">
            <TextBlock Classes="lbl" Text="#" />
            <TextBox Grid.Column="1" Text="{Binding BackgroundColor}" Watermark="#FFFFFF" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*" Margin="0,3">
            <TextBlock Classes="lbl" Text="{Binding L[Metric]}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Metrics}" SelectedItem="{Binding Metric}" HorizontalAlignment="Stretch" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*" Margin="0,3">
            <TextBlock Classes="lbl" Text="{Binding L[Dither]}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Dithers}" SelectedItem="{Binding Dither}" HorizontalAlignment="Stretch" />
          </Grid>
          <Border Classes="group">
            <StackPanel>
              <TextBlock><Run Text="{Binding L[DitherStrength]}" FontWeight="Bold" /><Run Text="{Binding DitherStrength, StringFormat='{} {0:P0}'}" /></TextBlock>
              <Slider Minimum="0" Maximum="1" Value="{Binding DitherStrength}" />
              <CheckBox Content="{Binding L[Serpentine]}" IsChecked="{Binding Serpentine}" />
              <CheckBox Content="{Binding L[LinearDiffusion]}" IsChecked="{Binding LinearDiffusion}" />
            </StackPanel>
          </Border>

          <Expander Header="{Binding L[Preprocessing]}">
            <StackPanel Spacing="2">
              <TextBlock><Run Text="{Binding L[Brightness]}" FontWeight="Bold" /><Run Text="{Binding Brightness, StringFormat=' {0:0.00}'}" /></TextBlock>
              <Slider Minimum="-1" Maximum="1" Value="{Binding Brightness}" />
              <TextBlock><Run Text="{Binding L[Contrast]}" FontWeight="Bold" /><Run Text="{Binding Contrast, StringFormat=' {0:0.00}'}" /></TextBlock>
              <Slider Minimum="-1" Maximum="1" Value="{Binding Contrast}" />
              <TextBlock><Run Text="{Binding L[Saturation]}" FontWeight="Bold" /><Run Text="{Binding Saturation, StringFormat=' {0:0.00}'}" /></TextBlock>
              <Slider Minimum="-1" Maximum="1" Value="{Binding Saturation}" />
              <TextBlock><Run Text="{Binding L[Gamma]}" FontWeight="Bold" /><Run Text="{Binding Gamma, StringFormat=' {0:0.00}'}" /></TextBlock>
              <Slider Minimum="0.3" Maximum="3" Value="{Binding Gamma}" />
              <TextBlock><Run Text="{Binding L[Sharpen]}" FontWeight="Bold" /><Run Text="{Binding Sharpen, StringFormat=' {0:0.00}'}" /></TextBlock>
              <Slider Minimum="0" Maximum="2" Value="{Binding Sharpen}" />
              <TextBlock Classes="h" Text="{Binding L[Placement]}" />
              <ComboBox ItemsSource="{Binding FitModes}" SelectedItem="{Binding Fit}" HorizontalAlignment="Stretch" Margin="0,2" />
              <ComboBox ItemsSource="{Binding Interpolations}" SelectedItem="{Binding Interp}" HorizontalAlignment="Stretch" Margin="0,2" />
              <CheckBox Content="{Binding L[LinearLight]}" IsChecked="{Binding LinearLight}" />
              <TextBlock><Run Text="{Binding L[Zoom]}" FontWeight="Bold" /><Run Text="{Binding Zoom, StringFormat=' {0:0.00}x'}" /></TextBlock>
              <Slider Minimum="0.25" Maximum="4" Value="{Binding Zoom}" />
              <TextBlock><Run Text="{Binding L[OffsetX]}" FontWeight="Bold" /><Run Text="{Binding OffsetX, StringFormat=' {0:0.00}'}" /></TextBlock>
              <Slider Minimum="-1" Maximum="1" Value="{Binding OffsetX}" />
              <TextBlock><Run Text="{Binding L[OffsetY]}" FontWeight="Bold" /><Run Text="{Binding OffsetY, StringFormat=' {0:0.00}'}" /></TextBlock>
              <Slider Minimum="-1" Maximum="1" Value="{Binding OffsetY}" />
            </StackPanel>
          </Expander>

          <Expander Header="{Binding L[Extras]}">
            <StackPanel Spacing="3">
              <TextBox Text="{Binding ProjectName}" Watermark="{Binding L[Project]}" />
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Classes="lbl" Text="{Binding L[MaxTypes]}" />
                <NumericUpDown Grid.Column="1" Value="{Binding MaxBlockTypes}" Minimum="0" Maximum="400" FormatString="0" />
              </Grid>
              <TextBlock Classes="note" Text="{Binding L[MaxTypesHint]}" />
              <TextBlock Classes="h" Text="{Binding L[Output]}" />
              <ComboBox ItemsSource="{Binding Splits}" SelectedItem="{Binding SplitOption}" HorizontalAlignment="Stretch" />
              <TextBlock Classes="note" Text="{Binding L[SplitHint]}" />
              <CheckBox Content="{Binding L[WriteBP]}" IsChecked="{Binding WriteBehaviorPack}" />
              <TextBlock Classes="h" Text="{Binding L[WorldPos]}" />
              <CheckBox Content="{Binding L[UseOrigin]}" IsChecked="{Binding UseOrigin}" />
              <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" IsEnabled="{Binding UseOrigin}">
                <TextBlock Text="{Binding L[MapX]}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <NumericUpDown Grid.Column="1" Value="{Binding OriginMapX}" FormatString="0" Minimum="-100000" Maximum="100000" ShowButtonSpinner="False" />
                <TextBlock Grid.Column="2" Text="{Binding L[MapZ]}" VerticalAlignment="Center" Margin="6,0,4,0" />
                <NumericUpDown Grid.Column="3" Value="{Binding OriginMapZ}" FormatString="0" Minimum="-100000" Maximum="100000" ShowButtonSpinner="False" />
                <TextBlock Grid.Column="4" Text="Y" VerticalAlignment="Center" Margin="6,0,4,0" />
                <NumericUpDown Grid.Column="5" Value="{Binding OriginY}" FormatString="0" Minimum="-64" Maximum="319" ShowButtonSpinner="False" />
              </Grid>
              <TextBlock Classes="note" Text="{Binding OriginText}" />
              <TextBlock Classes="h" Text="{Binding L[PlacementHeight]}" />
              <SelectableTextBlock Text="{Binding PlacementText}" TextWrapping="Wrap" FontSize="12" />
              <Button Content="{Binding L[ApplyRecommendedY]}" Command="{Binding ApplyRecommendedYCommand}" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Expander>

          <!-- Green buttons -->
          <StackPanel Margin="0,8,0,0">
            <Button Classes="green large" Content="{Binding L[BtnExport]}" Command="{Binding ExportBlockCommand}" />
            <Button Classes="green" Content="{Binding L[BtnView3D]}" Command="{Binding View3DCommand}" />
            <Button Classes="green" Content="{Binding L[BtnSavePng]}" Command="{Binding SavePreviewPngCommand}" />
            <Button Classes="green" Content="{Binding L[BtnTestPad]}" Command="{Binding ExportTestPadCommand}" />
          </StackPanel>

          <!-- Shading & build check -->
          <TextBlock Classes="h2" Text="{Binding L[SecAnalysis]}" Margin="0,12,0,4" />
          <TextBlock Text="{Binding ShadingVerdict}" Classes="ok" IsVisible="{Binding ShadingOk}" />
          <TextBlock Text="{Binding ShadingVerdict}" Classes="bad" IsVisible="{Binding ShadingProblem}" />
          <TextBlock Text="{Binding ShadingText}" TextWrapping="Wrap" FontSize="12" Margin="0,4" />
          <TextBlock Text="{Binding BlockSummary}" TextWrapping="Wrap" FontSize="12" />
          <Button Content="{Binding L[PvShadeMap]}" Command="{Binding ShowShadeMapCommand}" HorizontalAlignment="Stretch" Margin="0,4,0,0" />

          <!-- Materials -->
          <TextBlock Classes="h2" Text="{Binding L[SecMaterials]}" Margin="0,12,0,4" />
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Classes="lbl" Text="{Binding L[MaterialsPerMap]}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding MaterialAreas}" SelectedItem="{Binding MaterialArea}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ViewAreaOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <Border BorderBrush="White" BorderThickness="0,0,0,1" Margin="0,6,0,2">
            <Grid ColumnDefinitions="38,*,86,74,74">
              <TextBlock Grid.Column="1" Text="{Binding L[Block]}" FontWeight="Bold" />
              <TextBlock Grid.Column="2" Text="{Binding L[Amount]}" FontWeight="Bold" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="3" Text="{Binding L[Owned]}" FontWeight="Bold" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="{Binding L[Missing]}" FontWeight="Bold" HorizontalAlignment="Right" />
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding Materials}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MaterialViewModel">
                <Grid ColumnDefinitions="38,*,86,74,74" Margin="0,2">
                  <Panel Width="32" Height="32" VerticalAlignment="Top">
                    <Border Background="{Binding Swatch}" IsVisible="{Binding !HasIcon}" />
                    <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" RenderOptions.BitmapInterpolationMode="None" />
                  </Panel>
                  <StackPanel Grid.Column="1" Margin="4,0">
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                    <TextBlock Classes="note" Text="{Binding Maps}" />
                    <TextBlock Classes="note" Text="{Binding Alternatives}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Count, StringFormat='{}{0:N0}'}" HorizontalAlignment="Right" FontWeight="Bold" />
                    <TextBlock Classes="note" Text="{Binding Stacks}" HorizontalAlignment="Right" />
                  </StackPanel>
                  <NumericUpDown Grid.Column="3" Value="{Binding Owned}" Minimum="0" Maximum="10000000" FormatString="0"
                                 ShowButtonSpinner="False" Margin="4,0" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="4" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding MissingText}" HorizontalAlignment="Right" />
                    <TextBlock Classes="note" Text="{Binding MissingStacks}" HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="{Binding L[ExportMaterials]}" Command="{Binding ExportMaterialsCommand}" HorizontalAlignment="Stretch" Margin="0,4,0,0" />

          <Expander Header="{Binding L[Progress]}">
            <ItemsControl ItemsSource="{Binding MapProgress}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MapProgressViewModel">
                  <Grid ColumnDefinitions="44,150,*" Margin="0,2">
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="Bold" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding State}" HorizontalAlignment="Stretch" />
                    <TextBlock Grid.Column="2" Text="{Binding ChunksText}" VerticalAlignment="Center" Margin="8,0" Classes="note" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
